{
  "manifest_version": 3,
  "name": "AutoLogin",
  "description": "A transparent, user-controlled autofill helper for Safari web extensions.",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Open AutoLogin for the current page"
    }
  },
  "action": {
    "default_title": "AutoLogin",
    "default_icon": "images/toolbar-icon.svg",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
